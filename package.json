{
  "name": "ari-xp",
  "version": "0.1.0",
  "private": true,
  "description": "ARI XP web + iOS application foundation",
  "ari": {
    "iosBuild": 7
  },
  "scripts": {
    "auth-cache:experiment": "node scripts/ari-authorization-cache-harness.mjs",
    "cap:doctor": "cap doctor",
    "mobile:build": "node scripts/build-mobile-web.mjs",
    "ios:add": "cap add ios",
    "ios:set-build": "node scripts/set-ios-build-number.mjs",
    "ios:push-capability": "node scripts/ensure-ios-push-capability.mjs",
    "ios:verify-parity": "node scripts/verify-ios-public-parity.mjs",
    "ios:sync": "npm run mobile:build && npm run ios:set-build && cap sync ios && npm run ios:push-capability && npm run ios:verify-parity",
    "ios:open": "cap open ios",
    "chatgpt:browser:install": "npm install --no-save playwright@1.55.0 && npx playwright install chromium",
    "chatgpt:browser:login": "node scripts/ari-chatgpt-browser-worker.mjs login",
    "chatgpt:browser:worker": "node scripts/ari-chatgpt-browser-worker.mjs worker"
  },
  "dependencies": {
    "@capacitor/core": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/push-notifications": "8.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2"
  }
}
